#!/usr/bin/env bash
set -euo pipefail

FULCRUM_DATA_DIR="${APP_DATA_DIR}/data/fulcrum"
FULCRUM_LOG_DIR="${APP_DATA_DIR}/data/fulcrum-logs"
mkdir -p "${FULCRUM_DATA_DIR}" "${FULCRUM_LOG_DIR}"
chown -R 1000:1000 "${FULCRUM_DATA_DIR}" "${FULCRUM_LOG_DIR}"
find "${FULCRUM_DATA_DIR}" "${FULCRUM_LOG_DIR}" -type d -exec chmod u+rwx {} +
find "${FULCRUM_DATA_DIR}" "${FULCRUM_LOG_DIR}" -type f -exec chmod u+rw {} +

HIDDEN_SERVICE_FILE="${TOR_DATA_DIR}/app-${APP_ID}-rpc/hostname"
if [[ ! -f "${HIDDEN_SERVICE_FILE}" ]]; then
  "${UMBREL_ROOT}/scripts/app" compose "${APP_ID}" up --detach fulcrum
  "${UMBREL_ROOT}/scripts/app" compose "${APP_ID}" up --detach tor
  echo "App: ${APP_ID} - Generating Tor hidden service..."
  for _ in $(seq 1 100); do
    [[ -f "${HIDDEN_SERVICE_FILE}" ]] && break
    sleep 0.1
  done
fi
