    <label for="mcp-url">MCP server URL</label>
    <input id="mcp-url" type="text" readonly value="http://${DEVICE_DOMAIN_NAME}:8340/mcp" spellcheck="false" autocomplete="off">
    <p class="hint">Use this address on your local network. For remote connections, use a VPN or an HTTPS proxy.</p>

    <details>
      <summary>Show access token</summary>
      <label for="mcp-token">Bearer token</label>
      <input id="mcp-token" type="text" readonly value="<?php echo htmlspecialchars(UMBREL_MCP_TOKEN, ENT_QUOTES, 'UTF-8'); ?>" spellcheck="false" autocomplete="off">
      <p class="hint">This token grants access to notes in all profiles, including editing and deleting them. Give it only to clients you trust.</p>
    </details>

    <h2>Configure your client</h2>
    <p>Add an HTTP MCP server using the URL above. Choose bearer-token authentication and paste the token. If your client asks for a header, use <code>Authorization</code> with the value <code>Bearer YOUR_TOKEN</code>.</p>
    <p>Existing connections also need this token after the update. The URL and port stay the same, and the token stays the same across app restarts and updates on this Umbrel.</p>
    <p class="hint">Poznote's built-in AI assistant does not need this token.</p>
  </main>
  <script>
    // Match the address used to open Poznote, including custom hostnames and
    // IPv6 literals. Only the local MCP port and path differ.
    const endpoint = new URL(window.location.href);
    endpoint.protocol = 'http:';
    endpoint.port = '8340';
    endpoint.pathname = '/mcp';
    endpoint.search = '';
    endpoint.hash = '';
    document.getElementById('mcp-url').value = endpoint.href;
    document.querySelectorAll('input[readonly]').forEach(input => {
      input.addEventListener('click', () => input.select());
    });
  </script>
