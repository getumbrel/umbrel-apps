server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy to test if monolithic is listening
    location /api/monolithic-health {
        set $monolithic_backend http://monolithic:80/;
        proxy_pass $monolithic_backend;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
        proxy_send_timeout 2s;
    }
}
