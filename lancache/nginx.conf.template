server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri $uri/ /index.html;
    }

    # Proxy to test if monolithic is listening
    location /api/monolithic-health {
        proxy_pass http://monolithic:80/;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3s;
        proxy_send_timeout 2s;
    }

    # Proxy to live Steam Store Search API (resolves CORS and enables real-time search for any Steam game)
    location /api/steam/search/ {
        proxy_pass https://store.steampowered.com/api/storesearch/;
        proxy_set_header Host store.steampowered.com;
        proxy_ssl_server_name on;
        proxy_connect_timeout 5s;
        proxy_read_timeout 10s;
    }

    location = /api/steam/search {
        rewrite ^ /api/steam/search/ last;
    }
}
