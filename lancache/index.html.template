            <span class="info-val">${CACHE_DISK_SIZE}</span>
          </div>
          <div class="info-row">
            <span class="info-key">Upstream DNS Server</span>
            <span class="info-val">${UPSTREAM_DNS}</span>
          </div>
          <div class="info-row">
            <span class="info-key">Memory Cache Index</span>
            <span class="info-val">${CACHE_MEM_SIZE}</span>
          </div>
          <div class="info-row">
            <span class="info-key">Cache Retention Policy</span>
            <span class="info-val">${CACHE_MAX_AGE}</span>
          </div>
        </div>
        <div class="btn-row">
          <a href="https://lancache.net/docs/" target="_blank" rel="noopener" class="btn btn-red btn-sm">
            LanCache Documentation &rarr;
          </a>
          <a href="https://github.com/lancachenet/monolithic" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">
            Monolithic GitHub
          </a>
        </div>
      </div>

      <!-- Supported CDNs -->
      <div class="card">
        <div class="card-title">
          <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>
          Supported Gaming Services
        </div>
        <p style="font-size: 0.85rem; color: var(--text-muted);">
          LanCache transparently intercepts and accelerates chunk downloads from all major gaming networks on your LAN:
        </p>
        <div class="platform-chips">
          <span class="chip">&#127918; Steam</span>
          <span class="chip">&#127918; Epic Games</span>
          <span class="chip">&#127918; Riot (LoL &amp; Valorant)</span>
          <span class="chip">&#127918; Battle.net / Blizzard</span>
          <span class="chip">&#127918; EA App / Origin</span>
          <span class="chip">&#127918; Ubisoft Connect</span>
          <span class="chip">&#127918; Xbox &amp; PlayStation</span>
          <span class="chip">&#128187; Windows Update / WSUS</span>
        </div>
        <div class="callout callout-info" style="margin-top: auto;">
          <span>&#128161;</span>
          <div>
            <strong>Zero Client Mods:</strong> No software installation is required on gaming PCs or consoles. Simply point your router's primary DNS to your Umbrel node IP!
          </div>
        </div>
      </div>
    </div>

    <!-- PREFILL MULTI-STORE & LIBRARY MANAGER -->
    <div class="card prefill-card" id="prefillManager">
      <div class="card-title">
        <svg viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/></svg>
        <span>LanCache Multi-Store Prefill Manager</span>
        <span style="margin-left: auto; font-size: 0.78rem; font-weight: 500; color: var(--text-muted);">
          Schedule: <code style="color: #38bdf8;">${PREFILL_SCHEDULE}</code>
        </span>
      </div>

      <p style="font-size: 0.88rem; color: var(--text-muted);">
        Sign into your gaming stores to load your personal game libraries and pre-cache downloads wire-speed on your local network.
      </p>

      <!-- Stepper -->
      <div class="wizard-stepper">
        <div class="w-step active" id="wStep1" onclick="goToWizardStep(1)">
          <div class="w-step-num" id="wStepNum1">1</div>
          <span class="w-step-title">1. Choose Stores</span>
        </div>
        <div class="w-step-line" id="wLine1"></div>
        <div class="w-step" id="wStep2" onclick="goToWizardStep(2)">
          <div class="w-step-num" id="wStepNum2">2</div>
          <span class="w-step-title">2. Sign In</span>
        </div>
        <div class="w-step-line" id="wLine2"></div>
        <div class="w-step" id="wStep3" onclick="goToWizardStep(3)">
          <div class="w-step-num" id="wStepNum3">3</div>
          <span class="w-step-title">3. Game Libraries</span>
        </div>
      </div>

      <!-- STEP 1: CHOOSE STORES -->
      <div id="viewStep1" class="wizard-view active">
        <div style="font-size: 0.88rem; color: #fff; font-weight: 600;">
          Select the gaming platforms you want to connect:
        </div>

        <div class="store-grid">
          <!-- Steam -->
          <div class="store-card selected" id="cardStoreSteam" onclick="toggleStoreCard('steam')">
            <div class="store-card-check">
              <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            </div>
            <div class="store-card-icon icon-steam">
              <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-10 10c0 4.77 3.35 8.76 7.85 9.74l2.42-3.48a3.3 3.3 0 0 1-.37-.02l-3.32-1.37a2.5 2.5 0 0 1-1.44-2.27 2.5 2.5 0 0 1 2.5-2.5c.34 0 .66.07.96.2l3.4 1.4a3.3 3.3 0 0 1 2.9-.11l3.52-2.45A4.5 4.5 0 0 1 21 7.5 4.5 4.5 0 0 1 16.5 12c-1.3 0-2.46-.55-3.27-1.44l-3.6 2.5a3.3 3.3 0 0 1 .1 1.04c0 .32-.05.63-.14.93l-2.45 3.52A10 10 0 0 0 12 22a10 10 0 0 0 10-10A10 10 0 0 0 12 2zm4.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/></svg>
            </div>
            <div class="store-card-body">
              <h4>Steam</h4>
              <p>Valve Corporation &bull; Over 50,000 games &amp; updates</p>
              <span class="store-status-pill pill-unconnected" id="statusPillSteam">Not Signed In</span>
            </div>
          </div>

          <!-- Epic Games -->
          <div class="store-card" id="cardStoreEpic" onclick="toggleStoreCard('epic')">
            <div class="store-card-check">
              <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            </div>
            <div class="store-card-icon icon-epic">
              <svg viewBox="0 0 24 24"><path d="M4.5 2h15l1.5 14.5L12 22 3 16.5 4.5 2zm7.5 2.5L6.2 5.8l-.8 8.4L12 18.2l6.6-4 1.2-8.4-7.8-1.3zm0 2.2l4.8.8-.7 5.2-4.1 2.5-4.1-2.5-.5-5.2 4.6-.8z"/></svg>
            </div>
            <div class="store-card-body">
              <h4>Epic Games Store</h4>
              <p>Epic Games &bull; Fortnite, Unreal Engine &amp; exclusives</p>
              <span class="store-status-pill pill-unconnected" id="statusPillEpic">Not Signed In</span>
            </div>
          </div>

          <!-- Battle.net -->
          <div class="store-card" id="cardStoreBnet" onclick="toggleStoreCard('bnet')">
            <div class="store-card-check">
              <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
            </div>
            <div class="store-card-icon icon-bnet">
              <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zm0 8.5L5.5 8 12 4.7 18.5 8 12 10.5zM2 17l10 5 10-5-2.2-1.1L12 19.4l-7.8-3.5L2 17zm0-5l10 5 10-5-2.2-1.1L12 14.4l-7.8-3.5L2 12z"/></svg>
            </div>
            <div class="store-card-body">
              <h4>Battle.net</h4>
              <p>Blizzard Entertainment &bull; Call of Duty, WoW, Diablo</p>
              <span class="store-status-pill pill-unconnected" id="statusPillBnet">Not Signed In</span>
            </div>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; margin-top: 6px;">
          <button class="btn btn-red" onclick="proceedToStep2()">
            Continue to Sign-In &rarr;
          </button>
        </div>
      </div>

      <!-- STEP 2: CREDENTIALS & SIGN IN -->
      <div id="viewStep2" class="wizard-view">
        <div style="font-size: 0.88rem; color: #fff; font-weight: 600;">
          Enter credentials for your selected stores:
        </div>

        <div class="creds-container" id="credsContainer">
          <!-- Steam Credentials Panel -->
          <div class="cred-panel" id="panelCredSteam">
            <div class="cred-panel-header">
              <h4>
                <span class="tag-steam store-tag">Steam</span>
                Steam Account Sign-In
              </h4>
              <span class="store-status-pill pill-unconnected" id="panelStatusSteam">Not Connected</span>
            </div>

            <!-- DEFAULT: STEAM QR CODE SIGN-IN -->
            <div class="steam-qr-container" id="steamQrContainer">
              <div class="steam-qr-card">
                <div class="steam-qr-box">
                  <!-- Scalable SVG QR Code with center Steam Logo -->
                  <svg viewBox="0 0 100 100" class="steam-qr-svg">
                    <rect width="100" height="100" fill="#0d131c"/>
                    <!-- Corner Finder Patterns -->
                    <rect x="6" y="6" width="24" height="24" fill="none" stroke="#66c0f4" stroke-width="3"/>
                    <rect x="12" y="12" width="12" height="12" fill="#66c0f4"/>
                    <rect x="70" y="6" width="24" height="24" fill="none" stroke="#66c0f4" stroke-width="3"/>
                    <rect x="76" y="12" width="12" height="12" fill="#66c0f4"/>
                    <rect x="6" y="70" width="24" height="24" fill="none" stroke="#66c0f4" stroke-width="3"/>
                    <rect x="12" y="76" width="12" height="12" fill="#66c0f4"/>
                    <!-- Data Pattern Elements -->
                    <rect x="36" y="8" width="5" height="5" fill="#66c0f4"/><rect x="46" y="8" width="5" height="5" fill="#66c0f4"/><rect x="56" y="8" width="5" height="5" fill="#66c0f4"/>
                    <rect x="36" y="18" width="5" height="5" fill="#66c0f4"/><rect x="51" y="18" width="5" height="5" fill="#66c0f4"/>
                    <rect x="8" y="36" width="5" height="5" fill="#66c0f4"/><rect x="18" y="36" width="5" height="5" fill="#66c0f4"/><rect x="8" y="46" width="5" height="5" fill="#66c0f4"/><rect x="18" y="56" width="5" height="5" fill="#66c0f4"/>
                    <rect x="76" y="36" width="5" height="5" fill="#66c0f4"/><rect x="86" y="36" width="5" height="5" fill="#66c0f4"/><rect x="76" y="46" width="5" height="5" fill="#66c0f4"/><rect x="86" y="56" width="5" height="5" fill="#66c0f4"/>
                    <rect x="36" y="76" width="5" height="5" fill="#66c0f4"/><rect x="46" y="76" width="5" height="5" fill="#66c0f4"/><rect x="56" y="76" width="5" height="5" fill="#66c0f4"/>
                    <rect x="41" y="86" width="5" height="5" fill="#66c0f4"/><rect x="51" y="86" width="5" height="5" fill="#66c0f4"/><rect x="76" y="76" width="5" height="5" fill="#66c0f4"/><rect x="86" y="86" width="5" height="5" fill="#66c0f4"/>
                    <!-- Center circular emblem for Steam Logo -->
                    <circle cx="50" cy="50" r="16" fill="#171a21" stroke="#66c0f4" stroke-width="2"/>
                  </svg>
                  <!-- Center Steam Logo overlay -->
                  <div class="steam-qr-center-logo">
                    <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-10 10c0 4.77 3.35 8.76 7.85 9.74l2.42-3.48a3.3 3.3 0 0 1-.37-.02l-3.32-1.37a2.5 2.5 0 0 1-1.44-2.27 2.5 2.5 0 0 1 2.5-2.5c.34 0 .66.07.96.2l3.4 1.4a3.3 3.3 0 0 1 2.9-.11l3.52-2.45A4.5 4.5 0 0 1 21 7.5 4.5 4.5 0 0 1 16.5 12c-1.3 0-2.46-.55-3.27-1.44l-3.6 2.5a3.3 3.3 0 0 1 .1 1.04c0 .32-.05.63-.14.93l-2.45 3.52A10 10 0 0 0 12 22a10 10 0 0 0 10-10A10 10 0 0 0 12 2zm4.5 4a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/></svg>
                  </div>
                  <!-- Laser scan line animation -->
                  <div class="steam-qr-scanline"></div>
                </div>

                <div class="steam-qr-instructions">
                  <h5>Use the Steam Mobile App to sign in with QR code</h5>
                  <ol>
                    <li>Open the <strong>Steam Mobile App</strong> on your phone</li>
                    <li>Tap the <strong>Steam Guard</strong> shield icon</li>
                    <li>Select <strong>Scan QR Code</strong> and point your camera here</li>
                  </ol>
                  <div class="qr-status-indicator">
                    <span class="qr-pulse-dot"></span>
                    <span>Waiting for Steam Mobile scan...</span>
                  </div>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="approveSteamQrLogin()" style="margin-top: 6px; width: fit-content;">
                    &#128241; Approve Steam Mobile Login
                  </button>
                </div>
              </div>
            </div>

            <!-- TOGGLE BOX: SWITCH TO NORMAL SIGN IN -->
            <div class="steam-toggle-wrap">
              <label class="steam-toggle-label">
                <input type="checkbox" id="steamManualToggle" onchange="toggleSteamManualMode(this.checked)">
                <span>Switch to manual sign-in (Account Name &amp; Password)</span>
              </label>
            </div>

            <!-- MANUAL FORM (HIDDEN BY DEFAULT) -->
            <div class="form-row" id="steamManualFields" style="display: none; margin-top: 4px;">
              <div class="form-group">
                <label class="form-label" for="steamUsername">Steam Account Name / Username</label>
                <div class="form-input-wrap">
                  <input type="text" id="steamUsername" class="form-input" placeholder="e.g. gaben" autocomplete="username">
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="steamPassword">Password</label>
                <div class="form-input-wrap">
                  <input type="password" id="steamPassword" class="form-input" placeholder="••••••••••••" autocomplete="current-password">
                  <button type="button" class="pw-toggle" onclick="togglePwVisibility('steamPassword', this)">Show</button>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="steamGuard">Steam Guard 2FA (Optional / If prompted)</label>
                <div class="form-input-wrap">
                  <input type="text" id="steamGuard" class="form-input" placeholder="e.g. W4R9X or Mobile Code">
                </div>
              </div>
            </div>
            <div class="form-hint" id="steamManualHint" style="display: none;">
              Steam credentials are used to obtain your authorized game manifests from Valve CDNs.
            </div>
          </div>

          <!-- Epic Games Credentials Panel -->
          <div class="cred-panel" id="panelCredEpic">
            <div class="cred-panel-header">
              <h4>
                <span class="tag-epic store-tag">Epic Games</span>
                Epic Games Account Sign-In
              </h4>
              <span class="store-status-pill pill-unconnected" id="panelStatusEpic">Not Connected</span>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="epicEmail">Epic Account Email</label>
                <div class="form-input-wrap">
                  <input type="text" id="epicEmail" class="form-input" placeholder="e.g. player@example.com">
                </div>
              </div>
              <div class="form-group" style="grid-column: span 2;">
                <label class="form-label" for="epicAuthCode">Epic Authorization Code / Token</label>
                <div class="form-input-wrap">
                  <input type="text" id="epicAuthCode" class="form-input" placeholder="Paste your authorization code here...">
                </div>
              </div>
            </div>
            <div class="form-hint">
              Epic Games uses web authorization. Click <a href="https://legendary.gl/epiclogin" target="_blank" rel="noopener">Get Epic Login Code</a>, sign into Epic in your browser, and paste the generated code above.
            </div>
          </div>

          <!-- Battle.net Credentials Panel -->
          <div class="cred-panel" id="panelCredBnet">
            <div class="cred-panel-header">
              <h4>
                <span class="tag-bnet store-tag">Battle.net</span>
                Battle.net Account Sign-In
              </h4>
              <span class="store-status-pill pill-unconnected" id="panelStatusBnet">Not Connected</span>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="bnetEmail">Battle.net Email / BattleTag</label>
                <div class="form-input-wrap">
                  <input type="text" id="bnetEmail" class="form-input" placeholder="e.g. gamer#1234 or email">
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="bnetPassword">Password</label>
                <div class="form-input-wrap">
                  <input type="password" id="bnetPassword" class="form-input" placeholder="••••••••••••" autocomplete="current-password">
                  <button type="button" class="pw-toggle" onclick="togglePwVisibility('bnetPassword', this)">Show</button>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label" for="bnetCode">Authenticator Code (Optional)</label>
                <div class="form-input-wrap">
                  <input type="text" id="bnetCode" class="form-input" placeholder="e.g. 6-digit code">
                </div>
              </div>
            </div>
            <div class="form-hint">
              Required by Blizzard CDN to access owned Battle.net titles (CoD, WoW, Diablo IV).
            </div>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
          <button class="btn btn-secondary" onclick="goToWizardStep(1)">
            &larr; Back to Stores
          </button>
          <button class="btn btn-red" id="signInSubmitBtn" onclick="performStoreSignIn()">
            Sign In &amp; Load Libraries &rarr;
          </button>
        </div>
      </div>

      <!-- STEP 3: PERSONAL GAME LIBRARIES -->
      <div id="viewStep3" class="wizard-view">
        <div class="lib-browser">
          <div class="lib-controls">
            <div>
              <h3 style="color: #fff; font-size: 1rem; font-weight: 700;">Your Available Game Libraries</h3>
              <p style="font-size: 0.8rem; color: var(--text-muted);">
                Select the games you want to pre-download into your LanCache:
              </p>
            </div>
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <button class="btn btn-secondary btn-sm" onclick="selectAllInView(true)">Select All</button>
              <button class="btn btn-secondary btn-sm" onclick="selectAllInView(false)">Clear</button>
              <button class="btn btn-secondary btn-sm" onclick="openAddGameModal()">+ Add Custom Game</button>
              <button class="btn btn-secondary btn-sm" onclick="goToWizardStep(2)" style="color: #9ca3af;">&#9881; Manage Accounts</button>
            </div>
          </div>

          <!-- Connected Store Accounts Status Bar -->
          <div style="display: flex; gap: 8px; flex-wrap: wrap;" id="connectedAccountsBar">
            <!-- Dynamically populated -->
          </div>

          <!-- Store Tabs & Search Filter -->
          <div class="lib-filter-bar">
            <div class="lib-tabs" id="libTabsRow">
              <button class="lib-tab active" onclick="switchLibTab('all', this)" id="libTabAll">All Games (0)</button>
              <button class="lib-tab" onclick="switchLibTab('steam', this)" id="libTabSteam">Steam (0)</button>
              <button class="lib-tab" onclick="switchLibTab('epic', this)" id="libTabEpic">Epic Games (0)</button>
              <button class="lib-tab" onclick="switchLibTab('bnet', this)" id="libTabBnet">Battle.net (0)</button>
            </div>
            <div class="lib-search">
              <input type="text" id="libSearchBox" placeholder="Filter games by title or ID..." oninput="handleSearchInput(this.value)">
            </div>
          </div>

          <!-- Game Cards Grid -->
          <div class="lib-game-grid" id="libraryGameGrid">
            <!-- Injected by JavaScript -->
          </div>

          <!-- Prefill Action Bar -->
          <div class="prefill-action-bar">
            <div class="selection-summary">
              <div class="summary-badge" id="selectedGamesCount">0</div>
              <div class="summary-text">
                <strong id="selectedGamesTitleText">0 Games Selected for Prefill</strong>
                <span id="selectedGamesSizeEstimate">Estimated download: 0 GB</span>
              </div>
            </div>
            <button class="btn btn-red" onclick="startOneClickPrefill()">
              ⚡ Start Prefill Now &rarr;
            </button>
          </div>

          <!-- LIVE 1-CLICK PREFILL RUNNER PANEL -->
          <div class="prefill-runner-panel" id="prefillRunnerPanel">
            <div class="runner-header">
              <div class="runner-status">
                <span class="runner-pulse-indicator"></span>
                <div>
                  <h4 style="color: #fff; font-size: 0.96rem; font-weight: 700;" id="runnerTitleStatus">Prefill Active: Caching Games</h4>
                  <p style="font-size: 0.78rem; color: var(--text-muted);" id="runnerSubStatus">Prefilling game chunks wire-speed directly into LanCache local storage</p>
                </div>
              </div>
              <div class="runner-speed">
                <span class="speed-num" id="liveSpeedNum">964</span>
                <span class="speed-unit">MB/s</span>
              </div>
            </div>

            <!-- Overall Progress Bar -->
            <div class="progress-wrap">
              <div class="progress-bar-bg">
                <div class="progress-bar-fill" id="overallProgressBar" style="width: 0%;"></div>
              </div>
              <div class="progress-meta">
                <span id="progressPercentText">0%</span>
                <span id="progressGamesText">0 / 0 Games Cached</span>
                <span id="progressEstRemaining">Calculating speed...</span>
              </div>
            </div>

            <!-- Active Games List -->
            <div class="runner-game-list" id="runnerGameList">
              <!-- Rendered per selected game -->
            </div>

            <!-- Engine Console Log Window -->
            <div class="terminal-box" style="margin-top: 4px;">
              <div class="terminal-header">
                <div class="terminal-title">
                  <span class="terminal-dots"><span class="t-dot red"></span><span class="t-dot yellow"></span><span class="t-dot green"></span></span>
                  <span>Live LanCache Engine Activity Log</span>
                </div>
                <button class="btn btn-secondary btn-sm" onclick="clearLiveEngineLog()">Clear</button>
              </div>
              <div class="terminal-body" id="liveEngineLogBox" style="max-height: 180px; overflow-y: auto; font-size: 0.76rem; font-family: var(--font-mono); line-height: 1.5; color: #a5f3fc;">
                <!-- Streaming logs -->
              </div>
            </div>

            <!-- Runner Control Bar -->
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 4px;">
              <button class="btn btn-secondary btn-sm" id="btnPauseResumePrefill" onclick="togglePausePrefill()">
                &#9632; Pause
              </button>
              <div style="display: flex; gap: 8px;">
                <button class="btn btn-secondary btn-sm" onclick="toggleRawCommandView()">
                  <span id="rawCmdToggleText">View Raw Command</span>
                </button>
                <button class="btn btn-red btn-sm" onclick="saveToAutomatedSchedule()">
                  &#128197; Keep Updated with Daily Auto-Prefill
                </button>
              </div>
            </div>

            <!-- Optional Raw Command Accordion for Advanced Users -->
            <div id="rawCommandAccordion" style="display: none; margin-top: 6px; padding: 10px; background: #000; border-radius: 6px; border: 1px solid #333;">
              <div style="font-size: 0.75rem; color: #888; margin-bottom: 4px;">Command executed on LanCache:</div>
              <div style="display: flex; gap: 8px; align-items: center;">
                <code id="rawCommandText" style="color: #38bdf8; font-family: var(--font-mono); font-size: 0.78rem; flex: 1; overflow-x: auto;"></code>
                <button class="btn btn-secondary btn-sm" onclick="copyText(document.getElementById('rawCommandText').textContent)">Copy</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Setup & Router DNS Configuration -->
    <div class="card">
      <div class="card-title">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 17h-2v-2h2v2zm2.07-7.75l-.9.92C13.45 12.9 13 13.5 13 15h-2v-.5c0-1.1.45-2.1 1.17-2.83l1.24-1.26c.37-.36.59-.86.59-1.41 0-1.1-.9-2-2-2s-2 .9-2 2H7c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.04-.42 1.99-1.07 2.75z"/></svg>
        Quick Network Setup Guide
      </div>

      <div class="stepper">
        <div class="step-item">
          <div class="step-badge">1</div>
          <div class="step-content">
            <div class="step-heading">Configure Router DNS</div>
            <div class="step-text">
              Log into your home router's admin portal (DHCP Settings) and set your <strong>Primary DNS Server</strong> to your Umbrel IP:
            </div>
            <div style="display: flex; gap: 8px; align-items: center; margin-top: 6px;">
              <code id="dnsSnippet" style="background: #000; padding: 6px 12px; border-radius: 4px; font-family: var(--font-mono); font-size: 0.85rem; color: #38bdf8;">
                ${LANCACHE_IP}
              </code>
              <button class="btn btn-secondary btn-sm" onclick="copyText(document.getElementById('dnsSnippet').textContent.trim())">
                Copy IP
              </button>
            </div>
          </div>
        </div>

        <div class="step-item">
          <div class="step-badge">2</div>
          <div class="step-content">
            <div class="step-heading">Verify DNS Interception on your PC</div>
            <div class="step-text">
              Open Command Prompt (Windows) or Terminal (Mac/Linux) on your gaming PC and verify game domains resolve to your Umbrel:
            </div>
            <div style="display: flex; gap: 8px; align-items: center; margin-top: 6px;">
              <code style="background: #000; padding: 6px 10px; border-radius: 4px; font-family: var(--font-mono); font-size: 0.82rem; color: #38bdf8; flex: 1;">
                nslookup lancache.steamcontent.com ${LANCACHE_IP}
              </code>
              <button class="btn btn-secondary btn-sm" onclick="copyText('nslookup lancache.steamcontent.com ' + document.getElementById('ipValue').textContent.trim())">
                Copy
              </button>
            </div>
          </div>
        </div>

        <div class="step-item">
          <div class="step-badge">3</div>
          <div class="step-content">
            <div class="step-heading">Enjoy Gigabit Wire-Speed Downloads</div>
            <div class="step-text">
              Download any game or update on one PC. When any other PC or console downloads the same title, it will transfer from your Umbrel at full local gigabit (or 10GbE) wire speed!
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Umbrel Port 80 Routing Architecture Note -->
    <div class="card">
      <div class="card-title">
        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
        Umbrel Port 80 &amp; Router Forwarding Note
      </div>
      <div class="callout callout-warning">
        <span>&#9888;</span>
        <div style="font-size: 0.85rem; line-height: 1.5;">
          <strong>Port 80 Routing on Umbrel:</strong> Game clients download chunks over HTTP port 80. Because the Umbrel OS web manager reserves port 80 for the main dashboard, LanCache binds monolithic to port <strong>8261:80</strong>.
          <br><br>
          For maximum speed across your whole network, add a port forward / NAT rule in your router redirecting incoming TCP port <code>80</code> to <code>&lt;umbrel-ip&gt;:8261</code> for gaming traffic, or assign a secondary alias IP to your server.
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      Powered by <a href="https://lancache.net" target="_blank" rel="noopener">LanCache.NET</a> &bull; Official Community App for <a href="https://umbrel.com" target="_blank" rel="noopener">umbrelOS</a>
    </footer>
  <!-- Add Custom Game Modal -->
