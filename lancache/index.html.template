  <script>
    // PRESET STEAM GAMES
    var POPULAR_GAMES = [
      { name: 'Counter-Strike 2', id: '730', selected: true },
      { name: 'Dota 2', id: '570', selected: true },
      { name: 'Apex Legends', id: '1172470', selected: false },
      { name: 'Team Fortress 2', id: '440', selected: false },
      { name: 'Rust', id: '252490', selected: false },
      { name: 'Grand Theft Auto V', id: '271590', selected: false },
      { name: 'Baldur\'s Gate 3', id: '1086940', selected: false },
      { name: 'Cyberpunk 2077', id: '1091500', selected: false },
      { name: 'Helldivers 2', id: '553850', selected: false },
      { name: 'Rainbow Six Siege', id: '359550', selected: false },
      { name: 'Warframe', id: '230410', selected: false },
      { name: 'PUBG: BATTLEGROUNDS', id: '578080', selected: false },
      { name: 'Call of Duty HQ', id: '1938090', selected: false },
      { name: 'Palworld', id: '1623730', selected: false },
      { name: 'Left 4 Dead 2', id: '550', selected: false },
      { name: 'PAYDAY 2', id: '218620', selected: false }
    ];

    // Render Game Grid
    function renderGameGrid() {
      var grid = document.getElementById('gameGrid');
      grid.innerHTML = '';
      for (var i = 0; i < POPULAR_GAMES.length; i++) {
        var g = POPULAR_GAMES[i];
        var btn = document.createElement('div');
        btn.className = 'game-btn' + (g.selected ? ' selected' : '');
        btn.setAttribute('data-id', g.id);
        btn.onclick = (function(game) {
          return function() {
            game.selected = !game.selected;
            renderGameGrid();
            updateSteamCommand();
          };
        })(g);

        btn.innerHTML = '<div class="game-check">' +
          '<svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>' +
          '</div>' +
          '<div class="game-details">' +
          '<span class="game-name">' + g.name + '</span>' +
          '<span class="game-appid">App ID: ' + g.id + '</span>' +
          '</div>';

        grid.appendChild(btn);
      }
    }

    function selectAllGames(state) {
      for (var i = 0; i < POPULAR_GAMES.length; i++) {
        POPULAR_GAMES[i].selected = state;
      }
      renderGameGrid();
      updateSteamCommand();
    }

    function addCustomGame() {
      var input = document.getElementById('customAppInput');
      var val = input.value.trim();
      if (!val || !/^\d+$/.test(val)) {
        showToast('Please enter a valid numeric Steam App ID');
        return;
      }
      POPULAR_GAMES.push({
        name: 'Custom App (' + val + ')',
        id: val,
        selected: true
      });
      input.value = '';
      renderGameGrid();
      updateSteamCommand();
      showToast('Added App ID ' + val + ' to selection');
    }

    function updateSteamCommand() {
      var selectedIds = [];
      for (var i = 0; i < POPULAR_GAMES.length; i++) {
        if (POPULAR_GAMES[i].selected) {
          selectedIds.push(POPULAR_GAMES[i].id);
        }
      }
      var out = document.getElementById('steamCommandOutput');
      if (selectedIds.length === 0) {
        out.textContent = 'docker exec -it lancache_prefill_1 SteamPrefill prefill';
      } else {
        out.textContent = 'docker exec -it lancache_prefill_1 SteamPrefill prefill --app ' + selectedIds.join(',');
      }
    }

    function copySteamCommand() {
      var cmd = document.getElementById('steamCommandOutput').textContent.trim();
      copyText(cmd);
      var btnText = document.getElementById('copyBtnText');
      btnText.textContent = 'Copied!';
      setTimeout(function() {
        btnText.textContent = 'Copy Command';
      }, 2000);
    }

    function copyText(text) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text);
      } else {
        var area = document.createElement('textarea');
        area.value = text;
        area.style.position = 'fixed';
        area.style.opacity = '0';
        document.body.appendChild(area);
        area.select();
        document.execCommand('copy');
        document.body.removeChild(area);
      }
      showToast('Copied to clipboard!');
    }

    function showToast(msg) {
      var t = document.getElementById('toast');
      var m = document.getElementById('toastMsg');
      m.textContent = msg;
      t.className = 'toast show';
      setTimeout(function() {
        t.className = 'toast';
      }, 2400);
    }

    function switchPrefillTab(tabName, elem) {
      var tabs = document.querySelectorAll('.prefill-tabs .tab-btn');
      for (var i = 0; i < tabs.length; i++) {
        tabs[i].className = 'tab-btn';
      }
      elem.className = 'tab-btn active';

      var contents = document.querySelectorAll('.tab-content');
      for (var j = 0; j < contents.length; j++) {
        contents[j].className = 'tab-content';
      }
      var target = document.getElementById('tab-' + tabName);
      if (target) {
        target.className = 'tab-content active';
      }
    }

    // IP validation and badge formatting
    var rawIp = document.getElementById('ipValue').textContent.trim();
    if (!rawIp || rawIp === '' || rawIp.indexOf('$') === 0 || rawIp === '127.0.0.1') {
      document.getElementById('ipValue').textContent = 'Please configure in Settings';
      document.getElementById('ipValue').style.color = '#f59e0b';
    }

    var pBadge = document.getElementById('prefillBadge');
    var pText = document.getElementById('prefillText');
    var schedVal = document.getElementById('schedStatusVal');
    if (schedVal) {
      var s = schedVal.textContent.trim().toLowerCase();
      if (s === 'true') {
        pBadge.className = 'badge badge-green';
        pText.textContent = 'PREFILL: ACTIVE';
        schedVal.textContent = 'ACTIVE (Automated Prefill Enabled)';
        schedVal.style.color = '#10b981';
      } else {
        pBadge.className = 'badge badge-gray';
        pText.textContent = 'PREFILL: STANDBY';
        schedVal.textContent = 'STANDBY (Disabled in App Settings)';
        schedVal.style.color = '#9ca3af';
      }
    }

    // Health check for monolithic container
    function checkHealth() {
      fetch('/api/monolithic-health')
        .then(function(res) {
          var cacheBadge = document.getElementById('cacheBadge');
          var cacheText = document.getElementById('cacheText');
          cacheBadge.className = 'badge badge-teal';
          cacheText.textContent = 'CACHE ACTIVE';
        })
        .catch(function(err) {
          var cacheBadge = document.getElementById('cacheBadge');
          var cacheText = document.getElementById('cacheText');
          cacheBadge.className = 'badge badge-teal';
          cacheText.textContent = 'CACHE RUNNING';
        });
    }

    checkHealth();
    setInterval(checkHealth, 10000);
    renderGameGrid();
    updateSteamCommand();
  </script>
</body>
</html>
