      { id: 'Fortnite', name: 'Fortnite', store: 'epic', size: 55 },
      { id: 'Sugar', name: 'Rocket League', store: 'epic', size: 20 },
      { id: '0a2d9f6403244d12969e11da6713137b', name: 'Fall Guys', store: 'epic', size: 10 },
