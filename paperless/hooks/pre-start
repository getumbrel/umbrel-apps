#!/usr/bin/env bash
set -euo pipefail

# Paperless 3.0.2 restores the released paperless_mail.0002 migration graph, so
# the temporary 3.0.1 migration-history backfill must not run for users who skip
# from 3.0.0 to 3.0.2. Keep this no-op hook for one release to overwrite the
# 3.0.1 hook in existing app data.
echo "paperless pre-start: upstream 3.0.2 migration fix active; no migration-history backfill needed"
