.copy-mini { padding: 3px 9px; border: 1px solid var(--line-2); border-radius: 999px; background: #fff; cursor: pointer;
  font: 500 11px var(--mono); color: var(--ink-2); }
.copy-mini:hover { border-color: var(--ink); color: var(--ink); }
