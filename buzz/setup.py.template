  padding: 12px 14px; background: var(--soft); border: 1px solid var(--line); border-radius: 12px; font-size: 14px; }
dl.values dt { font: 500 10.5px var(--mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-3); }
