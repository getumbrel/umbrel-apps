{
	admin off
	auto_https off
	servers {
		timeouts {
			read_header 10s
		}
	}
}

# Phones pair through /pair; everything else is the relay. The gateway's script puts the community's
# own address in COMMUNITY_SITE on a domain, or every request (:80) on a Tailscale address.
COMMUNITY_SITE {
	reverse_proxy /pair* buzz_pair_1:5000
	reverse_proxy buzz_relay_1:3000
}
