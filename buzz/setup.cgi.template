#!/bin/awk -f

function html_escape(value, escaped) {
  escaped = value
  gsub(/&/, "\&amp;", escaped)
  gsub(/</, "\&lt;", escaped)
  gsub(/>/, "\&gt;", escaped)
  gsub(/\"/, "\&quot;", escaped)
  return escaped
}

function hex_value(character) {
  character = toupper(character)
  return character >= "0" && character <= "9" ? character + 0 : index("ABCDEF", character) + 9
}

function url_decode(value, decoded, index_at, character, first, second) {
  decoded = ""
  gsub(/\+/, " ", value)
  for (index_at = 1; index_at <= length(value); index_at++) {
    character = substr(value, index_at, 1)
    if (character == "%" && index_at + 2 <= length(value) && substr(value, index_at + 1, 2) !~ /[^0-9A-Fa-f]/) {
      first = hex_value(substr(value, index_at + 1, 1))
      second = hex_value(substr(value, index_at + 2, 1))
      decoded = decoded sprintf("%c", first * 16 + second)
      index_at += 2
    } else {
      decoded = decoded character
    }
  }
  return decoded
}

function url_encode(value, encoded, index_at, character, code) {
  encoded = ""
  for (index_at = 1; index_at <= length(value); index_at++) {
    character = substr(value, index_at, 1)
    if (character ~ /[A-Za-z0-9._~-]/) {
      encoded = encoded character
    } else {
      code = ascii_code[character]
      encoded = encoded sprintf("%%%02X", code == "" ? 63 : code)
    }
  }
  return encoded
}

function normalize_name(value) {
  gsub(/^[ ]+|[ ]+$/, "", value)
  gsub(/[ ][ ]+/, " ", value)
  return value
}

function valid_name(value) {
  return length(value) >= 2 && length(value) <= 48 && value !~ /[^A-Za-z0-9 ._-]/
}

function valid_funnel_relay_url(value) {
  return length(value) <= 260 && value ~ /^wss:\/\/[a-z0-9][a-z0-9.-]*[.]ts[.]net$/ && value !~ /[.][.]/
}

function valid_approval_url(value) {
  return length(value) <= 2048 && value ~ /^https:\/\/login[.]tailscale[.]com\// && value !~ /[[:space:]<>]/
}

function valid_integer(value, minimum, maximum) {
  return value ~ /^[0-9]+$/ && value + 0 >= minimum && value + 0 <= maximum
}

function setting(file, key, line, prefix, value) {
  prefix = key "="
  while ((getline line < file) > 0) {
    if (index(line, prefix) == 1) {
      value = substr(line, length(prefix) + 1)
      close(file)
      return value
    }
  }
  close(file)
  return ""
}

function setting_or(file, key, fallback, value) {
  value = setting(file, key)
  return value == "" ? fallback : value
}

function current_owner(value) {
  value = setting(owner_file, "RELAY_OWNER_PUBKEY")
  return length(value) == 64 && value !~ /[^0-9a-f]/ ? value : ""
}

function current_relay_url(value) {
  value = setting(community_file, "RELAY_URL")
  return value ~ /^wss?:\/\/[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]+)?$/ ? value : ""
}

function current_community_name(line, value) {
  if ((getline line < community_name_file) > 0) value = normalize_name(line)
  close(community_name_file)
  return valid_name(value) ? value : ""
}

function form_value(body, wanted, count, fields, index_at, separator, key) {
  count = split(body, fields, "&")
  for (index_at = 1; index_at <= count; index_at++) {
    separator = index(fields[index_at], "=")
    key = separator == 0 ? fields[index_at] : substr(fields[index_at], 1, separator - 1)
    if (key == wanted) return separator == 0 ? "" : url_decode(substr(fields[index_at], separator + 1))
  }
  return ""
}

function origin_for_relay(url, origin) {
  origin = url
  sub(/^ws:/, "http:", origin)
  sub(/^wss:/, "https:", origin)
  return origin
}

function bytes_to_mb(value) {
  return int((value + 0) / 1048576)
}

function load_settings() {
  cfg_huddle = setting_or(settings_file, "BUZZ_HUDDLE_AUDIO_AVAILABLE", "true")
  cfg_audit = setting_or(settings_file, "BUZZ_AUDIT_ENABLED", "true")
  cfg_connections = setting_or(settings_file, "BUZZ_MAX_CONNECTIONS", "10000")
  cfg_human_messages = setting_or(settings_file, "BUZZ_RATE_LIMIT_HUMAN_MESSAGES_PER_MIN", "60")
  cfg_human_api = setting_or(settings_file, "BUZZ_RATE_LIMIT_HUMAN_API_CALLS_PER_MIN", "300")
  cfg_human_ws = setting_or(settings_file, "BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC", "10")
  cfg_agent_standard_messages = setting_or(settings_file, "BUZZ_RATE_LIMIT_AGENT_STANDARD_MESSAGES_PER_MIN", "120")
  cfg_agent_standard_api = setting_or(settings_file, "BUZZ_RATE_LIMIT_AGENT_STANDARD_API_CALLS_PER_MIN", "600")
  cfg_agent_elevated_messages = setting_or(settings_file, "BUZZ_RATE_LIMIT_AGENT_ELEVATED_MESSAGES_PER_MIN", "300")
  cfg_agent_platform_messages = setting_or(settings_file, "BUZZ_RATE_LIMIT_AGENT_PLATFORM_MESSAGES_PER_MIN", "600")
  cfg_image_mb = bytes_to_mb(setting_or(settings_file, "BUZZ_MAX_IMAGE_BYTES", "52428800"))
  cfg_gif_mb = bytes_to_mb(setting_or(settings_file, "BUZZ_MAX_GIF_BYTES", "10485760"))
  cfg_video_mb = bytes_to_mb(setting_or(settings_file, "BUZZ_MAX_VIDEO_BYTES", "524288000"))
  cfg_file_mb = bytes_to_mb(setting_or(settings_file, "BUZZ_MAX_FILE_BYTES", "104857600"))
  cfg_uploads_concurrent = setting_or(settings_file, "BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS", "8")
  cfg_uploads_per_member = setting_or(settings_file, "BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS_PER_PUBKEY", "2")
  cfg_uploads_per_minute = setting_or(settings_file, "BUZZ_MEDIA_UPLOADS_PER_MINUTE", "30")
  cfg_git_pack_mb = bytes_to_mb(setting_or(settings_file, "BUZZ_GIT_MAX_PACK_BYTES", "524288000"))
  cfg_git_repo_mb = bytes_to_mb(setting_or(settings_file, "BUZZ_GIT_MAX_REPO_BYTES", "1073741824"))
  cfg_git_cache_mb = bytes_to_mb(setting_or(settings_file, "BUZZ_GIT_PACK_CACHE_MAX_BYTES", "5368709120"))
  cfg_git_repos = setting_or(settings_file, "BUZZ_GIT_MAX_REPOS_PER_PUBKEY", "100")
  cfg_git_ops = setting_or(settings_file, "BUZZ_GIT_MAX_CONCURRENT_OPS", "20")
}

function parse_settings(body) {
  cfg_huddle = form_value(body, "huddle_audio") == "true" ? "true" : "false"
  cfg_audit = form_value(body, "audit_log") == "true" ? "true" : "false"
  cfg_connections = form_value(body, "max_connections")
  cfg_human_messages = form_value(body, "human_messages")
  cfg_human_api = form_value(body, "human_api")
  cfg_human_ws = form_value(body, "human_ws")
  cfg_agent_standard_messages = form_value(body, "agent_standard_messages")
  cfg_agent_standard_api = form_value(body, "agent_standard_api")
  cfg_agent_elevated_messages = form_value(body, "agent_elevated_messages")
  cfg_agent_platform_messages = form_value(body, "agent_platform_messages")
  cfg_image_mb = form_value(body, "image_mb")
  cfg_gif_mb = form_value(body, "gif_mb")
  cfg_video_mb = form_value(body, "video_mb")
  cfg_file_mb = form_value(body, "file_mb")
  cfg_uploads_concurrent = form_value(body, "uploads_concurrent")
  cfg_uploads_per_member = form_value(body, "uploads_per_member")
  cfg_uploads_per_minute = form_value(body, "uploads_per_minute")
  cfg_git_pack_mb = form_value(body, "git_pack_mb")
  cfg_git_repo_mb = form_value(body, "git_repo_mb")
  cfg_git_cache_mb = form_value(body, "git_cache_mb")
  cfg_git_repos = form_value(body, "git_repos")
  cfg_git_ops = form_value(body, "git_ops")

  if (!valid_integer(cfg_connections, 100, 100000)) {
    error = "Maximum connections must be between 100 and 100,000."
  } else if (!valid_integer(cfg_human_messages, 1, 10000) || !valid_integer(cfg_human_api, 1, 50000) || !valid_integer(cfg_human_ws, 1, 1000)) {
    error = "Human rate limits must be positive numbers within the shown ranges."
  } else if (!valid_integer(cfg_agent_standard_messages, 1, 50000) || !valid_integer(cfg_agent_standard_api, 1, 100000) || !valid_integer(cfg_agent_elevated_messages, 1, 100000) || !valid_integer(cfg_agent_platform_messages, 1, 100000)) {
    error = "Agent rate limits must be positive numbers within the shown ranges."
  } else if (!valid_integer(cfg_image_mb, 1, 500) || !valid_integer(cfg_gif_mb, 1, 200) || !valid_integer(cfg_video_mb, 10, 5000) || !valid_integer(cfg_file_mb, 1, 1000)) {
    error = "Upload size limits must be positive numbers within the shown ranges."
  } else if (!valid_integer(cfg_uploads_concurrent, 1, 64) || !valid_integer(cfg_uploads_per_member, 1, 64) || !valid_integer(cfg_uploads_per_minute, 1, 1000)) {
    error = "Upload activity limits must be positive numbers within the shown ranges."
  } else if (cfg_uploads_per_member + 0 > cfg_uploads_concurrent + 0) {
    error = "Uploads per member cannot exceed total concurrent uploads."
  } else if (!valid_integer(cfg_git_pack_mb, 10, 5000) || !valid_integer(cfg_git_repo_mb, 10, 10000) || !valid_integer(cfg_git_cache_mb, 0, 51200) || !valid_integer(cfg_git_repos, 1, 1000) || !valid_integer(cfg_git_ops, 1, 100)) {
    error = "Git limits must be numbers within the shown ranges."
  } else if (cfg_git_repo_mb + 0 < cfg_git_pack_mb + 0) {
    error = "Maximum repository size cannot be smaller than maximum push size."
  }
  return error == ""
}

function write_owner_and_settings(new_owner, temporary_owner, temporary_settings) {
  temporary_owner = owner_file ".tmp"
  print "RELAY_OWNER_PUBKEY=" new_owner > temporary_owner
  close(temporary_owner)

  temporary_settings = settings_file ".tmp"
  print "BUZZ_HUDDLE_AUDIO_AVAILABLE=" cfg_huddle > temporary_settings
  print "BUZZ_AUDIT_ENABLED=" cfg_audit >> temporary_settings
  print "BUZZ_MAX_CONNECTIONS=" cfg_connections >> temporary_settings
  print "BUZZ_RATE_LIMIT_HUMAN_MESSAGES_PER_MIN=" cfg_human_messages >> temporary_settings
  print "BUZZ_RATE_LIMIT_HUMAN_API_CALLS_PER_MIN=" cfg_human_api >> temporary_settings
  print "BUZZ_RATE_LIMIT_HUMAN_WS_EVENTS_PER_SEC=" cfg_human_ws >> temporary_settings
  print "BUZZ_RATE_LIMIT_AGENT_STANDARD_MESSAGES_PER_MIN=" cfg_agent_standard_messages >> temporary_settings
  print "BUZZ_RATE_LIMIT_AGENT_STANDARD_API_CALLS_PER_MIN=" cfg_agent_standard_api >> temporary_settings
  print "BUZZ_RATE_LIMIT_AGENT_ELEVATED_MESSAGES_PER_MIN=" cfg_agent_elevated_messages >> temporary_settings
  print "BUZZ_RATE_LIMIT_AGENT_PLATFORM_MESSAGES_PER_MIN=" cfg_agent_platform_messages >> temporary_settings
  printf "BUZZ_MAX_IMAGE_BYTES=%.0f\n", cfg_image_mb * 1048576 >> temporary_settings
  printf "BUZZ_MAX_GIF_BYTES=%.0f\n", cfg_gif_mb * 1048576 >> temporary_settings
  printf "BUZZ_MAX_VIDEO_BYTES=%.0f\n", cfg_video_mb * 1048576 >> temporary_settings
  printf "BUZZ_MAX_FILE_BYTES=%.0f\n", cfg_file_mb * 1048576 >> temporary_settings
  print "BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS=" cfg_uploads_concurrent >> temporary_settings
  print "BUZZ_MEDIA_MAX_CONCURRENT_UPLOADS_PER_PUBKEY=" cfg_uploads_per_member >> temporary_settings
  print "BUZZ_MEDIA_UPLOADS_PER_MINUTE=" cfg_uploads_per_minute >> temporary_settings
  printf "BUZZ_GIT_MAX_PACK_BYTES=%.0f\n", cfg_git_pack_mb * 1048576 >> temporary_settings
  printf "BUZZ_GIT_MAX_REPO_BYTES=%.0f\n", cfg_git_repo_mb * 1048576 >> temporary_settings
  printf "BUZZ_GIT_PACK_CACHE_MAX_BYTES=%.0f\n", cfg_git_cache_mb * 1048576 >> temporary_settings
  print "BUZZ_GIT_MAX_REPOS_PER_PUBKEY=" cfg_git_repos >> temporary_settings
  print "BUZZ_GIT_MAX_CONCURRENT_OPS=" cfg_git_ops >> temporary_settings
  close(temporary_settings)

  return system("chmod 600 " temporary_owner " " temporary_settings " && mv " temporary_owner " " owner_file " && mv " temporary_settings " " settings_file) == 0
}

