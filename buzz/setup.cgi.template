  print "</style></head><body data-posted=\"" body_posted "\"><main><header class=\"hero\">"
  render_mark()
  print "<h1>Buzz Relay</h1></header><section class=\"content\">"
  if (message != "") print "<p class=\"notice ok\">" html_escape(message) "</p>"
  if (error != "") print "<p class=\"notice error\">" html_escape(error) "</p>"

  if (!ready_for_settings) {
    button_label = owner == "" ? "Start Buzz Relay" : "Finish setup"
    render_setup_form(owner, relay_url, community_name, owner != "", button_label, funnel_state, funnel_relay_url, funnel_approval_url, tailscale_app_url, umbrel_home_url)
  } else {
    render_status(status_state)
    initial_tab = settings_open ? "settings" : "home"
    print "<div id=\"ready-content\" data-initial-tab=\"" initial_tab "\" hidden>"
    print "<nav class=\"page-tabs\" role=\"tablist\" aria-label=\"Buzz Relay\"><button class=\"page-tab\" type=\"button\" id=\"home-tab\" role=\"tab\" aria-controls=\"home-panel\" aria-selected=\"true\" data-tab-target=\"home\">Home</button><button class=\"page-tab\" type=\"button\" id=\"settings-tab\" role=\"tab\" aria-controls=\"settings-panel\" aria-selected=\"false\" data-tab-target=\"settings\">Settings</button></nav>"
    print "<section id=\"home-panel\" class=\"tab-panel\" role=\"tabpanel\" aria-labelledby=\"home-tab\" data-tab-panel=\"home\">"
    print "<div class=\"identity\"><div class=\"summary\"><span class=\"summary-label\">Community name</span><strong>" html_escape(community_name) "</strong></div><div class=\"summary\"><span class=\"summary-label\">Relay address</span><code>" html_escape(relay_url) "</code></div></div>"
    if (!public_link_ready) {
      print "<div class=\"rule\"></div>"
      render_public_access(funnel_state, funnel_relay_url, funnel_approval_url, tailscale_app_url, umbrel_home_url)
    } else if (deep_link != "") {
      print "<div class=\"rule\"></div><section class=\"connect\" id=\"connect-section\" data-probe=\"/setup?public=1\"><h2>Connect Buzz Desktop</h2><p class=\"connect-check\" id=\"connect-status\">Checking your public address…</p><a class=\"primary\" id=\"connect-action\" href=\"" html_escape(deep_link) "\" hidden>Open in Buzz Desktop</a><div class=\"connect-error\" id=\"connect-error\" hidden>The public address is offline. Open Tailscale, sign in if asked, then restart Buzz Relay and return here.</div></section>"
    }
    print "</section><section id=\"settings-panel\" class=\"tab-panel\" role=\"tabpanel\" aria-labelledby=\"settings-tab\" data-tab-panel=\"settings\" hidden>"
    render_settings_form(owner)
    print "</section></div>"
  }

  print "</section></main><script>"
  print "(function(){"
  print "var draftKey='buzz-setup-draft-v1';var setupForm=document.getElementById('setup-form');try{if(setupForm){var communityInput=document.getElementById('community_name');var ownerInput=document.getElementById('owner_pubkey');var saved=localStorage.getItem(draftKey);if(saved){var draft=JSON.parse(saved);if(communityInput&&!communityInput.value&&typeof draft.communityName==='string')communityInput.value=draft.communityName;if(ownerInput&&!ownerInput.value&&typeof draft.ownerPubkey==='string')ownerInput.value=draft.ownerPubkey;}function saveDraft(){localStorage.setItem(draftKey,JSON.stringify({communityName:communityInput?communityInput.value:'',ownerPubkey:ownerInput?ownerInput.value:''}));}if(communityInput)communityInput.addEventListener('input',saveDraft);if(ownerInput)ownerInput.addEventListener('input',saveDraft);window.addEventListener('beforeunload',saveDraft);saveDraft();}else{localStorage.removeItem(draftKey);}}catch(draftError){}"
  print "var forms=document.querySelectorAll('form[data-submit-label]');for(var f=0;f<forms.length;f++){forms[f].addEventListener('submit',function(){var button=this.querySelector('.submit-button');if(!button)return;button.disabled=true;button.setAttribute('aria-busy','true');button.querySelector('.button-label').textContent=this.getAttribute('data-submit-label');});}"
  print "if(document.body.getAttribute('data-posted')==='1'&&window.history&&history.replaceState){history.replaceState(null,'','/setup');}"
  print "var readyContent=document.getElementById('ready-content');var tabs=document.querySelectorAll('[data-tab-target]');var panels=document.querySelectorAll('[data-tab-panel]');function selectTab(name){for(var t=0;t<tabs.length;t++){var selected=tabs[t].getAttribute('data-tab-target')===name;tabs[t].setAttribute('aria-selected',selected?'true':'false');tabs[t].tabIndex=selected?0:-1;}for(var p=0;p<panels.length;p++){panels[p].hidden=panels[p].getAttribute('data-tab-panel')!==name;}}for(var t=0;t<tabs.length;t++){tabs[t].addEventListener('click',function(){selectTab(this.getAttribute('data-tab-target'));});tabs[t].addEventListener('keydown',function(event){if(event.key!=='ArrowLeft'&&event.key!=='ArrowRight')return;event.preventDefault();var next=this===tabs[0]?tabs[1]:tabs[0];selectTab(next.getAttribute('data-tab-target'));next.focus();});}if(readyContent)selectTab(readyContent.getAttribute('data-initial-tab')||'home');"
  print "var connectSection=document.getElementById('connect-section');var connectAction=document.getElementById('connect-action');var connectStatus=document.getElementById('connect-status');var connectError=document.getElementById('connect-error');var publicAttempts=0;var publicStarted=false;function publicFailed(){if(!connectSection)return;connectStatus.textContent='Public address unavailable';connectError.hidden=false;}function checkPublicAddress(){fetch(connectSection.getAttribute('data-probe'),{cache:'no-store',credentials:'same-origin'}).then(function(response){return response.ok?response.json():null;}).then(function(data){if(data&&data.ready){connectStatus.textContent='Public address verified';connectAction.hidden=false;return;}publicAttempts+=1;if(publicAttempts<30){setTimeout(checkPublicAddress,2000);}else{publicFailed();}}).catch(function(){publicAttempts+=1;if(publicAttempts<30){setTimeout(checkPublicAddress,2000);}else{publicFailed();}});}function startPublicCheck(){if(connectSection&&!publicStarted){publicStarted=true;checkPublicAddress();}}"
  print "var status=document.getElementById('relay-status');if(status){var title=document.getElementById('status-title');var copy=document.getElementById('status-copy');var icon=status.querySelector('.status-icon');var attempts=0;function ready(){status.className='status-card ready';icon.innerHTML='✓';title.textContent='Buzz Relay is ready';copy.textContent='Your community is running and ready to connect.';if(readyContent)readyContent.hidden=false;startPublicCheck();}function delayed(){status.className='status-card delayed';icon.innerHTML='!';title.textContent='Buzz Relay is taking longer than expected';copy.textContent='Check the Buzz Relay logs in Umbrel, then restart the app if needed.';}function check(){fetch('/setup?status=1',{cache:'no-store',credentials:'same-origin'}).then(function(response){return response.ok?response.json():null;}).then(function(data){if(data&&data.ready){ready();return;}attempts+=1;if(attempts<60){setTimeout(check,2000);}else{delayed();}}).catch(function(){attempts+=1;if(attempts<60){setTimeout(check,2000);}else{delayed();}});}check();}"
  print "})();</script></body></html>"
