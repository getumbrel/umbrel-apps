  print ".field{display:grid;gap:6px}.field small{font-size:.75rem;line-height:1.4;color:#6a6a5f}.access-card{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px;border:1px solid #c4c414;border-radius:10px;background:#fafad9}.access-copy{display:grid;gap:3px}.access-steps{margin:2px 0 0;padding-left:19px}.access-steps li{margin:2px 0;font-size:.75rem;line-height:1.4;color:#6a6a5f}.access-actions{display:flex;gap:8px;flex:none}.secondary{display:inline-flex;align-items:center;justify-content:center;min-height:38px;padding:8px 12px;border:1px solid #171713;border-radius:8px;background:#fff;color:#171713;font-size:.8rem;font-weight:850;text-decoration:none;white-space:nowrap}.secondary:hover{background:#f0f0df}.error-card{border-color:#d7998d;background:#ffece8}.public-address{border-color:#91a74e;background:#edf4d7}.page-tabs{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:14px;padding:5px;border:1px solid #b7b7a7;border-radius:12px;background:#f0f0df}.page-tab{min-height:44px;border:0;border-radius:8px;background:transparent;color:#555548;font:900 .9rem Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer}.page-tab[aria-selected=true]{background:#171713;color:#d7d72e}.page-tab:focus-visible{outline:3px solid #d7d72e;outline-offset:2px}.tab-panel{margin-top:14px}.tab-panel .identity{margin-top:0}.tab-panel .settings{margin-top:0}.tab-panel .settings fieldset:first-child{border-top:0}@media(max-width:560px){.access-card,.access-actions{align-items:stretch;flex-direction:column}.secondary{width:100%}}"
