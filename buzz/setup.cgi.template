function render_public_access(state, relay_url, approval_url, tailscale_url, umbrel_url) {
  if (state == "ready") {
    print "<div class=\"summary public-address\"><span class=\"summary-label\">Public address</span><code>" html_escape(relay_url) "</code></div>"
    print "<p class=\"muted\">Public via Tailscale Funnel. Community members do not need Tailscale.</p>"
  } else if (state == "needs-approval") {
    print "<div class=\"access-card\"><div class=\"access-copy\"><strong>Approve the public address</strong><ol class=\"access-steps\"><li>Open the approval link and allow Tailscale Funnel.</li><li>Return to Umbrel Home.</li><li>Right-click Buzz Relay and choose Restart.</li></ol></div><div class=\"access-actions\"><a class=\"secondary\" href=\"" html_escape(approval_url) "\" target=\"_blank\" rel=\"noreferrer\">Approve</a><a class=\"secondary\" href=\"" html_escape(umbrel_url) "\" target=\"_top\">Umbrel Home</a></div></div>"
  } else if (state == "conflict") {
    print "<div class=\"access-card error-card\"><div class=\"access-copy\"><strong>Public address unavailable</strong><ol class=\"access-steps\"><li>Open Tailscale.</li><li>Remove the existing Funnel or Serve rule using port 443.</li><li>Return to Umbrel Home, right-click Buzz Relay, and choose Restart.</li></ol></div><div class=\"access-actions\"><a class=\"secondary\" href=\"" html_escape(tailscale_url) "\" target=\"_blank\" rel=\"noreferrer\">Open Tailscale</a><a class=\"secondary\" href=\"" html_escape(umbrel_url) "\" target=\"_top\">Umbrel Home</a></div></div>"
  } else if (state == "error") {
    print "<div class=\"access-card error-card\"><div class=\"access-copy\"><strong>Public address unavailable</strong><ol class=\"access-steps\"><li>Open Tailscale and check its connection.</li><li>Sign in if Tailscale asks.</li><li>Return to Umbrel Home, right-click Buzz Relay, and choose Restart.</li></ol></div><div class=\"access-actions\"><a class=\"secondary\" href=\"" html_escape(tailscale_url) "\" target=\"_blank\" rel=\"noreferrer\">Open Tailscale</a><a class=\"secondary\" href=\"" html_escape(umbrel_url) "\" target=\"_top\">Umbrel Home</a></div></div>"
  } else {
    print "<div class=\"access-card\"><div class=\"access-copy\"><strong>Set up Tailscale</strong><ol class=\"access-steps\"><li>Open Tailscale and sign in.</li><li>Return to Umbrel Home.</li><li>Right-click Buzz Relay and choose Restart.</li><li>If Buzz asks for Funnel approval, approve it and restart again.</li></ol></div><div class=\"access-actions\"><a class=\"secondary\" href=\"" html_escape(tailscale_url) "\" target=\"_blank\" rel=\"noreferrer\">Open Tailscale</a><a class=\"secondary\" href=\"" html_escape(umbrel_url) "\" target=\"_top\">Umbrel Home</a></div></div>"
  }
  if (state != "ready") {
    print "<p class=\"muted\">Tailscale is required on this Umbrel to create your public Buzz address. Sign in once; community members do not need Tailscale.</p>"
  }
}

