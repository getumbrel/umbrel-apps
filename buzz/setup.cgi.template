  if (locked && community_name != "") {
    print "<input type=\"hidden\" name=\"community_name\" value=\"" html_escape(community_name) "\"><div class=\"summary\"><span class=\"summary-label\">Community name</span><strong>" html_escape(community_name) "</strong></div>"
