function render_page(message, error, owner, relay_url, community_name, ready_for_settings, status_state, settings_open, connect_url, deep_link, body_posted, public_link_ready) {
  connect_url = relay_url == "" ? funnel_relay_url : relay_url
  deep_link = owner != "" && community_name != "" ? "buzz://add-community?relay=" url_encode(connect_url) "&name=" url_encode(community_name) : ""
  body_posted = method == "POST" ? "1" : "0"
  public_link_ready = relay_url !~ /^wss:\/\/[a-zA-Z0-9][a-zA-Z0-9.-]*[.]ts[.]net$/ || (funnel_state == "ready" && funnel_relay_url == relay_url)

  print "HTTP/1.1 200 OK\r"
  print "Content-Type: text/html; charset=utf-8\r"
  print "Connection: close\r"
  print "Cache-Control: no-store\r"
