r-color:#171713;background:#f7f7cd;box-shadow:inset 4px 0 0 #d7d72e}.mode input:focus-visible+.mode-card{outline:3px solid #d7d72e;outline-offset:2px}.mode-title{display:block;font-weight:850}.mode-copy{display:block;margin-top:4px;font-size:.79rem;line-height:1.4;color:#66665a}.guide{margin-top:2px;padding:14px;border:1px solid #c4c414;border-radius:11px;background:#fafad9}.guide[hidden]{display:none}.guide ol{margin:9px 0 0;padding-left:21px}.guide li{margin:4px 0;font-size:.83rem}.summary{padding:12px 13px;border:1px solid #d0d0c2;border-radius:10px;background:#f7f7ef}.summary-label{display:block;margin-bottom:4px;font-size:.7rem;font-weight:850;color:#6b6b60;text-transform:uppercase;letter-spacing:.06em}.summary code{display:block}.key-note{padding:11px 13px;border-radius:9px;background:#f7f7cd;font-size:.84rem;color:#4e4e42}.submit-button,.primary{display:inline-flex;align-items:center;justify-content:center;gap:9px;width:100%;border:1px solid #171713;border-radius:10px;padding:13px 17px;background:#171713;color:#d7d72e;font:850 .92rem Inter,ui-sans-serif,system-ui,sans-serif;text-decoration:none;cursor:pointer}.start-button{margin-top:5px;padding:16px 18px;font-size:1rem;box-shadow:3px 3px 0 #8d8d18}.submit-button:hover,.primary:hover{background:#303028}.submit-button:disabled{cursor:wait;opacity:.82}.button-spinner,.status-spinner{display:none;width:17px;height:17px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:spin .75s linear infinite}.submit-button[aria-busy=true] .button-spinner,.status-spinner{display:block}@keyframes spin{to{transform:rotate(360deg)}}.status-card{display:flex;align-items:center;gap:13px;padding:15px;border:1px solid #b7b7a7;border-radius:12px;background:#f7f7ef}.status-card .status-icon{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#171713;color:#d7d72e;flex:none}.status-card>span:last-child{display:grid;gap:2px}.status-card strong{font-size:.95rem}.status-card small{color:#646457;line-height:1.35}.status-card.ready{background:#edf4d7;border-color:#91a74e}.status-card.ready .status-icon{background:#3f5515;color:#fff}.status-card.delayed{background:#fff3cd;border-color:#d3b358}.identity{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}.identity .summary{min-width:0}.lock-note{margin:10px 0 0;font-size:.8rem}.rule{height:1px;background:#deded2;margin:24px 0}.connect{padding:18px;border-radius:12px;background:#171713;color:#fff}.connect h2{margin:0 0 5px;font-size:1.08rem}.connect p{margin:0 0 12px;color:#cfcfc0}.connect .primary{background:#d7d72e;color:#171713;border-color:#d7d72e}.connect code{display:block;margin-top:11px;color:#d7d72e}.connect .fallback{margin-top:11px;font-size:.76rem;color:#aaa99c}.settings{margin-top:18px;border:1px solid #c8c8ba;border-radius:12px;background:#fff}.settings>summary{display:flex;justify-content:space-between;align-items:center;padding:15px 16px;font-weight:900;cursor:pointer}.summary-meta{padding:4px 7px;border-radius:99px;background:#f0f0df;font-size:.67rem;text-transform:uppercase;letter-spacing:.05em}.settings form{padding:0 16px 17px}.settings fieldset{display:grid;gap:11px;margin:0;padding:17px 0;border:0;border-top:1px solid #e0e0d5}.settings legend{padding:0 0 10px;font-weight:900}.settings-grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}.setting-field{display:grid;align-content:start;gap:5px}.setting-field small,.switch-row small{font-size:.73rem;line-height:1.35;color:#747467}.switch-row{display:flex;align-items:center;justify-content:space-between;gap:18px}.switch-row>span:first-child{display:grid;gap:3px}.switch{position:relative;display:block;width:44px;height:25px;flex:none}.switch input{position:absolute;opacity:0}.switch span{position:absolute;inset:0;border-radius:99px;background:#adada1;cursor:pointer;transition:.15s}.switch span:before{content:\"\";position:absolute;width:19px;height:19px;left:3px;top:3px;border-radius:50%;background:#fff;transition:.15s;box-shadow:0 1px 3px #0004}.switch input:checked+span{background:#171713}.switch input:checked+span:before{transform:translateX(19px);background:#d7d72e}.switch input:focus-visible+span{outline:3px solid #d7d72e;outline-offset:2px}.settings-note{margin:0;padding:11px 12px;border-radius:9px;background:#f7f7ef;font-size:.78rem}code{font:650 .8rem ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere}strong{color:inherit}@media(prefers-reduced-motion:reduce){.button-spinner,.status-spinner{animation:none}}@media(max-width:560px){body{padding:0;background:#fffef7}main{border:0;border-radius:0;box-shadow:none;min-height:100vh}.hero{padding:21px 19px}.brand-mark{width:42px}.content{padding:22px 19px 26px}.modes,.identity,.settings-grid{grid-template-columns:1fr}.guide,.connect{padding:14px}}"
  print "</style></head><body data-posted=\"" body_posted "\"><main><header class=\"hero\">"
  render_mark()
  print "<h1>Buzz Relay</h1></header><section class=\"content\">"
  if (message != "") print "<p class=\"notice ok\">" html_escape(message) "</p>"
  if (error != "") print "<p class=\"notice error\">" html_escape(error) "</p>"

  if (!ready_for_settings) {
    button_label = owner == "" ? "Start Buzz Relay" : "Finish setup"
    render_setup_form(owner, relay_url, community_name, mode, owner != "", local_checked, tailscale_checked, button_label)
  } else {
    render_status(status_state)
    print "<div class=\"identity\"><div class=\"summary\"><span class=\"summary-label\">Community name</span><strong>" html_escape(community_name) "</strong></div><div class=\"summary\"><span class=\"summary-label\">Relay address</span><code>" html_escape(relay_url) "</code></div></div>"
    print "<p class=\"lock-note\">The name and address stay fixed because existing Buzz Desktop connections use them. A new relay address represents a different community.</p>"
    if (mode == "tailscale") render_tailscale_guide("")
    if (deep_link != "") {
      print "<div class=\"rule\"></div><section class=\"connect\"><h2>Connect Buzz Desktop</h2><p>Add <strong>" html_escape(community_name) "</strong> with everything filled in.</p><a class=\"primary\" href=\"" html_escape(deep_link) "\">Open in Buzz Desktop</a><div class=\"fallback\">Or enter this address manually:</div><code>" html_escape(connect_url) "</code></section>"
    }
    render_settings_form(owner, settings_open ? "open" : "")
  }

  print "</section></main><script>"
  print "(function(){"
  print "var guide=document.getElementById('tailscale-guide');var choices=document.querySelectorAll('input[name=connection]');function syncGuide(){if(!guide||!choices.length)return;var selected=document.querySelector('input[name=connection]:checked');guide.hidden=!selected||selected.value!=='tailscale';}for(var i=0;i<choices.length;i++){choices[i].addEventListener('change',syncGuide);}syncGuide();"
  print "var forms=document.querySelectorAll('form[data-submit-label]');for(var f=0;f<forms.length;f++){forms[f].addEventListener('submit',function(){var button=this.querySelector('.submit-button');if(!button)return;button.disabled=true;button.setAttribute('aria-busy','true');button.querySelector('.button-label').textContent=this.getAttribute('data-submit-label');});}"
  print "if(document.body.getAttribute('data-posted')==='1'&&window.history&&history.replaceState){history.replaceState(null,'','/setup');}"
  print "var status=document.getElementById('relay-status');if(status){var title=document.getElementById('status-title');var copy=document.getElementById('status-copy');var icon=status.querySelector('.status-icon');var attempts=0;function ready(){status.className='status-card ready';icon.innerHTML='✓';title.textContent='Buzz Relay is ready';copy.textContent='Your community is running and ready to connect.';}function delayed(){status.className='status-card delayed';icon.innerHTML='!';title.textContent='Buzz Relay is taking longer than expected';copy.textContent='Check the Buzz Relay logs in Umbrel, then restart the app if needed.';}function check(){fetch('/setup?status=1',{cache:'no-store',credentials:'same-origin'}).then(function(response){return response.ok?response.json():null;}).then(function(data){if(data&&data.ready){ready();return;}attempts+=1;if(attempts<60){setTimeout(check,2000);}else{delayed();}}).catch(function(){attempts+=1;if(attempts<60){setTimeout(check,2000);}else{delayed();}});}check();}"
  print "})();</script></body></html>"
}

BEGIN {
  for (ascii = 1; ascii < 128; ascii++) ascii_code[sprintf("%c", ascii)] = ascii

  owner_file = ENVIRON["OWNER_FILE"] == "" ? "/data/relay/owner.env" : ENVIRON["OWNER_FILE"]
  community_file = ENVIRON["COMMUNITY_FILE"] == "" ? "/data/relay/community.env" : ENVIRON["COMMUNITY_FILE"]
  community_name_file = ENVIRON["COMMUNITY_NAME_FILE"] == "" ? "/www/community-name.txt" : ENVIRON["COMMUNITY_NAME_FILE"]
  settings_file = ENVIRON["SETTINGS_FILE"] == "" ? "/data/relay/settings.env" : ENVIRON["SETTINGS_FILE"]
  local_relay_url = ENVIRON["LOCAL_RELAY_URL"]
  tailscale_relay_url = ENVIRON["TAILSCALE_RELAY_URL"]
  method = ENVIRON["SETUP_METHOD"]
  message = ""
  error = ""
  status_state = "checking"
  settings_open = 0
  owner = current_owner()
  relay_url = current_relay_url()
  community_name = current_community_name()
  was_configured = owner != ""
  had_community_name = community_name != ""
  mode = relay_url == tailscale_relay_url ? "tailscale" : "local"
  load_settings()

  if (method == "POST") {
    body = ENVIRON["SETUP_BODY"]
    intent = form_value(body, "intent")
    if (body == "REQUEST_TOO_LARGE") {
      error = "Request is too large."
    } else if (intent == "settings") {
      settings_open = 1
      submitted_owner = tolower(form_value(body, "owner_pubkey"))
      if (!was_configured || !had_community_name) {
        error = "Finish community setup before changing advanced settings."
      } else if (length(submitted_owner) != 64 || submitted_owner ~ /[^0-9a-f]/) {
        error = "Enter the 64-character hexadecimal public key shown by Buzz Desktop."
      } else if (parse_settings(body)) {
        if (write_owner_and_settings(submitted_owner)) {
          owner = submitted_owner
          status_state = "applying"
        } else {
          error = "Could not save settings. Check the app logs."
        }
      }
    } else if (intent == "setup") {
      value = form_value(body, "owner_pubkey")
      submitted_name = normalize_name(form_value(body, "community_name"))
      connection = form_value(body, "connection")
      selected_url = connection == "tailscale" ? tailscale_relay_url : local_relay_url
      owner = tolower(value)
      community_name = submitted_name
      if (connection == "local" || connection == "tailscale") mode = connection

      if (!valid_name(submitted_name)) {
        error = "Enter a community name using 2–48 letters, numbers, spaces, dots, underscores, or hyphens."
      } else if (had_community_name && submitted_name != current_community_name()) {
        error = "The community name is fixed after first setup because existing Desktop connections use it."
      } else if (connection != "local" && connection != "tailscale") {
        error = "Choose where you will use Buzz."
      } else if (length(value) != 64 || value ~ /[^0-9A-Fa-f]/) {
        error = "Enter the 64-character hexadecimal public key shown by Buzz Desktop."
      } else if (was_configured && relay_url != "" && selected_url != relay_url) {
        error = "The relay address is fixed because changing it creates a different community."
      } else {
        origin = origin_for_relay(selected_url)
        temporary_community = community_file ".tmp"
        print "RELAY_URL=" selected_url > temporary_community
        print "BUZZ_CORS_ORIGINS=" origin ",tauri://localhost,http://localhost:1420" >> temporary_community
        print "BUZZ_MEDIA_BASE_URL=" origin "/media" >> temporary_community
        close(temporary_community)
        temporary_owner = owner_file ".tmp"
        print "RELAY_OWNER_PUBKEY=" tolower(value) > temporary_owner
        close(temporary_owner)
        temporary_name = community_name_file ".tmp"
        print submitted_name > temporary_name
        close(temporary_name)

        if (system("chmod 600 " temporary_community " " temporary_owner " && chmod 644 " temporary_name " && mv " temporary_community " " community_file " && mv " temporary_owner " " owner_file " && mv " temporary_name " " community_name_file) != 0) {
          error = "Could not save the community. Check the app logs."
        } else {
          owner = tolower(value)
          relay_url = selected_url
          community_name = submitted_name
          mode = connection
          status_state = was_configured ? "checking" : "starting"
        }
      }
    } else {
      error = "Unknown form action."
    }
  } else if (method != "GET" && method != "HEAD") {
    error = "Unsupported request method."
  }

  ready_for_settings = owner != "" && community_name != ""
  render_page(message, error, owner, relay_url, community_name, mode, ready_for_settings, status_state, settings_open)
}
