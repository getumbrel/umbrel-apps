BEGIN {
  for (ascii = 1; ascii < 128; ascii++) ascii_code[sprintf("%c", ascii)] = ascii

  owner_file = ENVIRON["OWNER_FILE"] == "" ? "/data/relay/owner.env" : ENVIRON["OWNER_FILE"]
  community_file = ENVIRON["COMMUNITY_FILE"] == "" ? "/data/relay/community.env" : ENVIRON["COMMUNITY_FILE"]
  community_name_file = ENVIRON["COMMUNITY_NAME_FILE"] == "" ? "/www/community-name.txt" : ENVIRON["COMMUNITY_NAME_FILE"]
  funnel_status_file = ENVIRON["FUNNEL_STATUS_FILE"] == "" ? "/www/funnel-status.env" : ENVIRON["FUNNEL_STATUS_FILE"]
  settings_file = ENVIRON["SETTINGS_FILE"] == "" ? "/data/relay/settings.env" : ENVIRON["SETTINGS_FILE"]
  tailscale_app_url = ENVIRON["TAILSCALE_APP_URL"]
  umbrel_home_url = ENVIRON["UMBREL_HOME_URL"]
  method = ENVIRON["SETUP_METHOD"]
  message = ""
  error = ""
  status_state = "checking"
  settings_open = 0
  owner = current_owner()
  relay_url = current_relay_url()
  community_name = current_community_name()
  funnel_state = setting(funnel_status_file, "FUNNEL_STATE")
  funnel_relay_url = setting(funnel_status_file, "FUNNEL_RELAY_URL")
  funnel_approval_url = setting(funnel_status_file, "FUNNEL_APPROVAL_URL")
  if (!valid_funnel_relay_url(funnel_relay_url)) funnel_relay_url = ""
  if (!valid_approval_url(funnel_approval_url)) funnel_approval_url = ""
  if (funnel_state != "ready" && funnel_state != "needs-login" && funnel_state != "needs-approval" && funnel_state != "conflict" && funnel_state != "error") funnel_state = "needs-login"
  if (funnel_state == "ready" && funnel_relay_url == "") funnel_state = "error"
  if (funnel_state == "needs-approval" && funnel_approval_url == "") funnel_state = "error"
  was_configured = owner != ""
  had_community_name = community_name != ""
  load_settings()

  if (method == "POST") {
    body = ENVIRON["SETUP_BODY"]
    intent = form_value(body, "intent")
    if (body == "REQUEST_TOO_LARGE") {
      error = "Request is too large."
    } else if (intent == "settings") {
      settings_open = 1
      submitted_owner = tolower(form_value(body, "owner_pubkey"))
      if (!was_configured || !had_community_name) {
        error = "Finish community setup before changing advanced settings."
      } else if (length(submitted_owner) != 64 || submitted_owner ~ /[^0-9a-f]/) {
        error = "Enter the 64-character hexadecimal public key shown by Buzz Desktop."
      } else if (parse_settings(body)) {
        if (write_owner_and_settings(submitted_owner)) {
          owner = submitted_owner
          status_state = "applying"
        } else {
          error = "Could not save settings. Check the app logs."
        }
      }
    } else if (intent == "setup") {
      value = form_value(body, "owner_pubkey")
      submitted_name = normalize_name(form_value(body, "community_name"))
      address_locked = was_configured && relay_url != ""
      selected_url = address_locked ? relay_url : funnel_relay_url
      owner = tolower(value)
      community_name = submitted_name

      if (!valid_name(submitted_name)) {
        error = "Enter a community name using 2–48 letters, numbers, spaces, dots, underscores, or hyphens."
      } else if (had_community_name && submitted_name != current_community_name()) {
        error = "The community name is fixed after first setup because existing Desktop connections use it."
      } else if (!address_locked && (funnel_state != "ready" || !valid_funnel_relay_url(selected_url))) {
        error = "Connect Tailscale and enable the public link before starting Buzz Relay."
      } else if (length(value) != 64 || value ~ /[^0-9A-Fa-f]/) {
        error = "Enter the 64-character hexadecimal public key shown by Buzz Desktop."
      } else if (was_configured && relay_url != "" && selected_url != relay_url) {
        error = "The relay address is fixed because changing it creates a different community."
      } else {
        origin = origin_for_relay(selected_url)
        temporary_community = community_file ".tmp"
        print "RELAY_URL=" selected_url > temporary_community
        print "BUZZ_CORS_ORIGINS=" origin ",tauri://localhost,http://localhost:1420" >> temporary_community
        print "BUZZ_MEDIA_BASE_URL=" origin "/media" >> temporary_community
        close(temporary_community)
        temporary_owner = owner_file ".tmp"
        print "RELAY_OWNER_PUBKEY=" tolower(value) > temporary_owner
        close(temporary_owner)
        temporary_name = community_name_file ".tmp"
        print submitted_name > temporary_name
        close(temporary_name)

        if (system("chmod 600 " temporary_community " " temporary_owner " && chmod 644 " temporary_name " && mv " temporary_community " " community_file " && mv " temporary_owner " " owner_file " && mv " temporary_name " " community_name_file) != 0) {
          error = "Could not save the community. Check the app logs."
        } else {
          owner = tolower(value)
          relay_url = selected_url
          community_name = submitted_name
          status_state = was_configured ? "checking" : "starting"
        }
      }
    } else {
      error = "Unknown form action."
    }
  } else if (method != "GET" && method != "HEAD") {
    error = "Unsupported request method."
  }

  ready_for_settings = owner != "" && community_name != ""
  render_page(message, error, owner, relay_url, community_name, ready_for_settings, status_state, settings_open)
}
