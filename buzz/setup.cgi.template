  checked = (name == "huddle_audio" ? cfg_huddle : cfg_audit) == "true" ? "checked" : ""
  print "<label class=\"switch-row\"><span><strong>" title "</strong><small>" description "</small></span><span class=\"switch\"><input type=\"checkbox\" name=\"" name "\" value=\"true\" " checked "><span aria-hidden=\"true\"></span></span></label>"
}

