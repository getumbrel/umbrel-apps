  print "<section id=\"relay-status\" class=\"status-card pending\" data-action=\"" state "\" aria-live=\"polite\" aria-atomic=\"true\"><span class=\"status-icon\"><span class=\"status-spinner\"></span></span><span><strong id=\"status-title\">" title "</strong><small id=\"status-copy\">" copy "</small></span></section>"
}

