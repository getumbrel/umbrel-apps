  print ":root{color-scheme:light;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;background:#d7d72e;color:#171713}*{box-sizing:border-box}[hidden]{display:none!important}body{margin:0;min-height:100vh;padding:32px 16px;background:#d7d72e}main{width:100%;max-width:700px;margin:0 auto;background:#fffef7;border:2px solid #171713;border-radius:18px;overflow:hidden;box-shadow:7px 7px 0 #171713}.hero{display:flex;align-items:center;gap:16px;padding:25px 28px;background:#d7d72e;border-bottom:2px solid #171713}.brand-mark{width:50px;height:auto;color:#000;flex:none}h1{margin:0;font-size:clamp(1.7rem,5vw,2.25rem);letter-spacing:-.04em;line-height:1.05}.content{padding:26px 28px 30px}p,li{line-height:1.5;color:#58584e}.notice{margin:0 0 14px;padding:11px 13px;border-radius:9px;font-weight:750}.ok{background:#edf4d7;color:#33400f}.error{background:#ffe2dc;color:#751f10}form{display:grid;gap:12px}.step{display:flex;align-items:center;gap:9px;margin:20px 0 0}.step:first-of-type{margin-top:0}.step-number{display:grid;place-items:center;width:25px;height:25px;border-radius:50%;background:#171713;color:#d7d72e;font-size:.76rem;font-weight:900}.step h2{margin:0;font-size:1.06rem}.muted{margin:0;font-size:.84rem;color:#6a6a5f}.field-label,.setting-label{font-size:.86rem;font-weight:850}input[type=text],input[type=number]{width:100%;min-width:0;padding:12px 13px;border:1px solid #9d9d8e;border-radius:9px;background:#fff;color:#171713;font:650 .92rem Inter,ui-sans-serif,system-ui,sans-serif}.owner-input{font-family:ui-monospace,SFMono-Regular,Consolas,monospace!important;font-size:.82rem!important}input:focus{outline:3px solid #d7d72e;outline-offset:1px;border-color:#626208}.modes{display:grid;grid-template-columns:1fr 1fr;gap:9px}.mode{position:relative;display:block}.mode input{position:absolute;opacity:0}.mode-card{display:block;height:100%;padding:13px;border:1px solid #b7b7a7;border-radius:10px;background:#fff;cursor:pointer}.mod