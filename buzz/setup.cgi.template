function render_status(state, title, copy) {
  if (state == "starting") {
    title = "Starting Buzz Relay…"
    copy = "This usually takes less than a minute. You can keep this page open."
  } else if (state == "applying") {
    title = "Applying your settings…"
    copy = "Buzz Relay will reconnect automatically when the changes are active."
  } else {
    title = "Checking Buzz Relay…"
    copy = "Confirming that the relay is ready."
  }
  print "<section id=\"relay-status\" class=\"status-card pending\" data-action=\"" state "\" aria-live=\"polite\" aria-atomic=\"true\"><span class=\"status-icon\"><span class=\"status-spinner\"></span></span><span><strong id=\"status-title\">" title "</strong><small id=\"status-copy\">" copy "</small></span></section>"
}

