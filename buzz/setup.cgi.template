#!/bin/awk -f

function html_escape(value, escaped) {
  escaped = value
  gsub(/&/, "\&amp;", escaped)
  gsub(/</, "\&lt;", escaped)
  gsub(/>/, "\&gt;", escaped)
  gsub(/\"/, "\&quot;", escaped)
  return escaped
}

function setting(file, key, line, prefix, value) {
  prefix = key "="
  while ((getline line < file) > 0) {
    if (index(line, prefix) == 1) {
      value = substr(line, length(prefix) + 1)
      close(file)
      return value
    }
  }
  close(file)
  return ""
}

function current_owner(value) {
  value = setting(owner_file, "RELAY_OWNER_PUBKEY")
  return length(value) == 64 && value !~ /[^0-9a-f]/ ? value : ""
}

function current_relay_url(value) {
  value = setting(community_file, "RELAY_URL")
  return value ~ /^wss?:\/\/[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]+)?$/ ? value : ""
}

function form_value(body, wanted, count, fields, i, separator, key) {
  count = split(body, fields, "&")
  for (i = 1; i <= count; i++) {
    separator = index(fields[i], "=")
    key = separator == 0 ? fields[i] : substr(fields[i], 1, separator - 1)
    if (key == wanted) return separator == 0 ? "" : substr(fields[i], separator + 1)
  }
  return ""
}

function origin_for_relay(url, origin) {
  origin = url
  sub(/^ws:/, "http:", origin)
  sub(/^wss:/, "https:", origin)
  return origin
}

function render_mark() {
  print "<svg class=\"brand-mark\" aria-hidden=\"true\" viewBox=\"0 0 466 309\"><defs><mask id=\"buzz-cutouts\"><rect width=\"466\" height=\"309\" fill=\"white\"/><circle cx=\"193.3\" cy=\"84.4\" r=\"27\" fill=\"black\"/><circle cx=\"276\" cy=\"84.4\" r=\"27\" fill=\"black\"/><rect x=\"166.3\" y=\"157.2\" width=\"136.9\" height=\"38.3\" rx=\"5\" fill=\"black\"/><rect x=\"166.9\" y=\"235.1\" width=\"136.2\" height=\"37.6\" rx=\"5\" fill=\"black\"/></mask></defs><rect width=\"466\" height=\"309\" fill=\"currentColor\" mask=\"url(#buzz-cutouts)\"/></svg>"
}

function render_page(message, error, owner, relay_url, button_label, mode, locked, local_checked, tailscale_checked) {
  print "HTTP/1.1 200 OK\r"
  print "Content-Type: text/html; charset=utf-8\r"
  print "Connection: close\r"
  print "Cache-Control: no-store\r"
  print "X-Content-Type-Options: nosniff\r"
  print "Referrer-Policy: no-referrer\r"
  print "\r"
  print "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
  print "<title>Buzz Relay setup</title><style>"
  print ":root{color-scheme:light;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;background:#f1f1e8;color:#171713}*{box-sizing:border-box}"
  print "body{margin:0;min-height:100vh;padding:24px 16px;background:#f1f1e8}main{width:100%;max-width:640px;margin:0 auto;background:#fff;border:1px solid #d8d8ca;border-radius:20px;overflow:hidden;box-shadow:0 18px 50px rgba(23,23,19,.10)}"
  print ".hero{padding:28px 30px 24px;border-top:8px solid #d7d72e;border-bottom:1px solid #e5e5d9}.brand{display:flex;align-items:center;gap:10px;font-size:.9rem;font-weight:850;letter-spacing:.02em}.brand-mark{width:42px;height:auto;color:#171713;flex:none}"
  print "h1{margin:20px 0 8px;font-size:clamp(1.8rem,6vw,2.35rem);letter-spacing:-.04em;line-height:1.05}p,li{line-height:1.55;color:#55554a}.hero p{max-width:520px;margin:0}.content{padding:26px 30px 30px}.status{display:inline-flex;align-items:center;gap:7px;font-size:.78rem;font-weight:800;color:#55554a}.dot{width:8px;height:8px;border-radius:50%;background:#d7d72e;border:1px solid #77770d}"
  print "h2{margin:28px 0 7px;font-size:1.08rem;letter-spacing:-.01em}h2:first-of-type{margin-top:22px}.intro{margin:0 0 14px}.notice{padding:11px 13px;border-radius:10px;font-weight:700}.ok{background:#edf4d7;color:#33400f}.error{background:#ffe2dc;color:#751f10}.muted{margin:0;font-size:.88rem;color:#6b6b60}"
  print "form{display:grid;gap:14px;margin:0}.field-label{font-weight:800}.modes{display:grid;gap:9px}.mode{position:relative;display:block}.mode input{position:absolute;opacity:0}.mode-card{display:block;padding:13px 14px;border:1px solid #c6c6b9;border-radius:12px;background:#fff;cursor:pointer}.mode input:checked+.mode-card{border-color:#77770d;background:#f5f5ce}.mode input:focus-visible+.mode-card{outline:3px solid #d7d72e;outline-offset:2px}.mode-title{display:block;font-weight:800;color:#171713}.mode-url{display:block;margin-top:4px;font:600 .8rem ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere;color:#5d5d52}"
  print ".summary{padding:13px 14px;border:1px solid #d6d6c9;border-radius:12px;background:#f7f7ef}.summary-label{display:block;margin-bottom:5px;font-size:.78rem;font-weight:800;color:#6b6b60;text-transform:uppercase;letter-spacing:.05em}"
  print "input[type=text]{width:100%;min-width:0;padding:13px 14px;border-radius:11px;border:1px solid #a8a89b;background:#fff;color:#171713;font:600 .9rem ui-monospace,SFMono-Regular,Consolas,monospace}input[type=text]:focus{outline:3px solid #d7d72e;outline-offset:1px;border-color:#77770d}"
  print "button{justify-self:start;border:0;border-radius:10px;padding:12px 18px;background:#171713;color:#d7d72e;font:800 .95rem Inter,ui-sans-serif,system-ui,sans-serif;cursor:pointer}button:hover{background:#2d2d26}"
  print "code{display:block;font:600 .84rem ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere;color:#171713}.key-note{padding:12px 14px;border-radius:10px;background:#f5f5ce;font-size:.88rem;color:#4e4e42}.current-owner{margin-top:18px}.rule{height:1px;background:#e1e1d6;margin:28px 0}.connect{padding:18px;border-radius:14px;background:#171713}.connect h2{margin:0 0 6px;color:#fff}.connect p{margin:0 0 12px;color:#cfcfc0}.connect strong{color:#fff}.connect code{color:#d7d72e}strong{color:#171713}"
  print "@media(max-width:520px){body{padding:0;background:#fff}main{border:0;border-radius:0;box-shadow:none}.hero{padding:22px 20px 18px}.content{padding:22px 20px 26px}h1{margin-top:16px}.brand-mark{width:36px}.connect{margin-left:-4px;margin-right:-4px;padding:16px}}"
  print "</style></head><body><main><section class=\"hero\"><div class=\"brand\">"
  render_mark()
  print "<span>Buzz Relay · Umbrel</span></div><h1>Set up your relay</h1><p>Host a private Buzz community on your Umbrel.</p></section><section class=\"content\">"
  print "<div class=\"status\"><span class=\"dot\"></span>" (owner == "" ? "Waiting for setup" : "Community configured") "</div>"
  if (message != "") print "<p class=\"notice ok\">" html_escape(message) "</p>"
  if (error != "") print "<p class=\"notice error\">" html_escape(error) "</p>"
  print "<form method=\"post\" action=\"/setup\" autocomplete=\"off\">"
  if (locked) {
    print "<input type=\"hidden\" name=\"connection\" value=\"" mode "\">"
    print "<h2>Relay address</h2><div class=\"summary\"><span class=\"summary-label\">Locked after setup</span><code>" html_escape(relay_url) "</code></div>"
  } else {
    print "<h2>1. Choose access</h2><p class=\"intro\">This address becomes the community identity after setup.</p><div class=\"modes\">"
    print "<label class=\"mode\"><input type=\"radio\" name=\"connection\" value=\"local\" " local_checked "><span class=\"mode-card\"><span class=\"mode-title\">Local network</span><span class=\"mode-url\">" html_escape(local_relay_url) "</span></span></label>"
    print "<label class=\"mode\"><input type=\"radio\" name=\"connection\" value=\"tailscale\" " tailscale_checked "><span class=\"mode-card\"><span class=\"mode-title\">Tailscale · private remote access</span><span class=\"mode-url\">" html_escape(tailscale_relay_url) "</span></span></label>"
    print "</div><p class=\"muted\">Tailscale requires the Umbrel and your other devices to share a tailnet with MagicDNS enabled.</p>"
  }
  print "<h2>" (locked ? "Owner identity" : "2. Add the owner") "</h2><label class=\"field-label\" for=\"owner_pubkey\">Owner public key</label>"
  print "<input type=\"text\" id=\"owner_pubkey\" name=\"owner_pubkey\" inputmode=\"text\" minlength=\"64\" maxlength=\"64\" pattern=\"[0-9a-fA-F]{64}\" placeholder=\"Paste 64-character hex public key\" autocapitalize=\"none\" spellcheck=\"false\" required>"
  print "<p class=\"muted\">Copy it from <strong>Buzz Desktop → Settings → Identity</strong>. Need one? Create or import your identity in Buzz Desktop first.</p>"
  print "<div class=\"key-note\"><strong>Never paste an nsec here.</strong> Umbrel only needs your public key and creates a separate service key for the relay.</div>"
  print "<button type=\"submit\">" button_label "</button></form>"
  if (owner != "") print "<div class=\"current-owner\"><p class=\"muted\">Current owner</p><code>" html_escape(owner) "</code></div>"
  print "<div class=\"rule\"></div><div class=\"connect\"><h2>Connect Buzz Desktop</h2><p>Choose <strong>Join an existing community</strong>, then enter:</p><code>" html_escape(relay_url == "" ? local_relay_url : relay_url) "</code></div>"
  print "</section></main></body></html>"
}

BEGIN {
  owner_file = ENVIRON["OWNER_FILE"] == "" ? "/data/relay/owner.env" : ENVIRON["OWNER_FILE"]
  community_file = ENVIRON["COMMUNITY_FILE"] == "" ? "/data/relay/community.env" : ENVIRON["COMMUNITY_FILE"]
  local_relay_url = ENVIRON["LOCAL_RELAY_URL"]
  tailscale_relay_url = ENVIRON["TAILSCALE_RELAY_URL"]
  method = ENVIRON["SETUP_METHOD"]
  message = ""
  error = ""
  owner = current_owner()
  relay_url = current_relay_url()
  was_configured = owner != ""
  mode = relay_url == tailscale_relay_url ? "tailscale" : "local"

  if (method == "POST") {
    body = ENVIRON["SETUP_BODY"]
    if (body == "REQUEST_TOO_LARGE") {
      error = "Request is too large."
    } else {
      value = form_value(body, "owner_pubkey")
      connection = form_value(body, "connection")
      selected_url = connection == "tailscale" ? tailscale_relay_url : local_relay_url

      if (connection != "local" && connection != "tailscale") {
        error = "Choose local network or Tailscale access."
      } else if (length(value) != 64 || value ~ /[^0-9A-Fa-f]/) {
        error = "Enter the 64-character hexadecimal public key shown by Buzz Desktop."
      } else if (was_configured && relay_url != "" && selected_url != relay_url) {
        error = "The relay address is locked after first setup to protect the community identity."
      } else {
        value = tolower(value)
        origin = origin_for_relay(selected_url)
        temporary_community = community_file ".tmp"
        print "RELAY_URL=" selected_url > temporary_community
        print "BUZZ_CORS_ORIGINS=" origin ",tauri://localhost,http://localhost:1420" >> temporary_community
        print "BUZZ_MEDIA_BASE_URL=" origin "/media" >> temporary_community
        close(temporary_community)

        if (system("chmod 600 " temporary_community " && mv " temporary_community " " community_file) != 0) {
          error = "Could not save the relay address. Check the app logs."
        } else {
          temporary_owner = owner_file ".tmp"
          print "RELAY_OWNER_PUBKEY=" value > temporary_owner
          close(temporary_owner)
          if (system("chmod 600 " temporary_owner " && mv " temporary_owner " " owner_file) != 0) {
            error = "Could not save the owner key. Check the app logs."
          } else {
            owner = value
            relay_url = selected_url
            mode = connection
            message = was_configured ? "Owner key saved. Restart Buzz Relay in Umbrel to apply the change." : "Configuration saved. Buzz Relay is starting now."
          }
        }
      }
    }
  } else if (method != "GET" && method != "HEAD") {
    error = "Unsupported request method."
  }

  button_label = owner == "" ? "Start Buzz Relay" : "Save owner key"
  locked = owner != ""
  local_checked = mode == "local" ? "checked" : ""
  tailscale_checked = mode == "tailscale" ? "checked" : ""
  render_page(message, error, owner, relay_url, button_label, mode, locked, local_checked, tailscale_checked)
}
