# Soroban constants, copied verbatim from upstream Dojo's
# docker/my-dojo/.env at v1.29.3. They are values, not user settings -- the
# toggles that Umbrel actually varies (network, announce, port, data paths)
# live in docker-compose.yml.
#
# This is a top-level *.template so that Umbrel re-renders it into installed
# apps on update; a plain committed file would only reach fresh installs.
# There is nothing to substitute, which is fine: envsubst passes it through.
SOROBAN_LOG_LEVEL="info"
SOROBAN_DOMAIN_MAIN="soroban"
SOROBAN_DOMAIN_TEST="soroban-test"
SOROBAN_ONION_FILE="/home/soroban/data/hostname"
SOROBAN_DHT_SERVER_MODE="off"
SOROBAN_ANNOUNCE_KEY_MAIN="soroban.cluster.mainnet.nodes"
SOROBAN_ANNOUNCE_KEY_TEST="soroban.cluster.testnet.nodes"
SOROBAN_P2P_ROOM_MAIN="soroban-dojo"
SOROBAN_P2P_ROOM_TEST="soroban-dojo-test"
SOROBAN_P2P_LISTEN_PORT=1042
SOROBAN_P2P_LOWWATER=16
SOROBAN_P2P_HIGHWATER=40
SOROBAN_P2P_PEERSTORE_FILE="/home/soroban/data/peerstore"
